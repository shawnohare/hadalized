{% set theme = context -%}
{% set utils = utils -%}
-- WARNING: Auto-generated by {{ theme.app_info }}

local theme = {
   name = "{{ theme.fullname }}",
   desc = "{{ theme.desc }}",
   version = "{{ theme.version }}",
   url = "{{ theme.url }}",
   palette = {{ theme.palette.model_dump_lua(indent_level=1) }}
}

vim.cmd([[ highlight clear ]])
vim.o.bg = theme.palette.mode

-- Highlight groups are set from a mapping
-- neovim hl group -> universal theme field -> palette color
{% for group, settings in utils.neovim.transform(theme) -%}
vim.api.nvim_set_hl(0, "{{ group }}", {{ settings }})
{% endfor -%}
