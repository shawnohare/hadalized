# Autogenerated file defining a wezterm colorscheme.
# WARNING: Do not edit by hand.
{% set thm = context %}
{% set pal = context.palette %}

[colors]
ansi = [
    "{{ thm.ansi00 }}",
    "{{ thm.ansi01 }}",
    "{{ thm.ansi02 }}",
    "{{ thm.ansi03 }}",
    "{{ thm.ansi04 }}",
    "{{ thm.ansi05 }}",
    "{{ thm.ansi06 }}",
    "{{ thm.ansi07 }}",
]
brights = [
    "{{ thm.ansi08 }}",
    "{{ thm.ansi09 }}",
    "{{ thm.ansi10 }}",
    "{{ thm.ansi11 }}",
    "{{ thm.ansi12 }}",
    "{{ thm.ansi13 }}",
    "{{ thm.ansi14 }}",
    "{{ thm.ansi15 }}",
]

background    = "{{ thm.main.bg }}"
foreground    = "{{ thm.main.fg }}"
cursor_border = "{{ thm.cursor.border }}"
cursor_bg     = "{{ thm.cursor.bg }}"
cursor_fg     = "{{ thm.cursor.fg }}"
selection_bg  = "{{ thm.selection.bg}}"
{% if thm.selection.fg -%}
selection_fg  = "{{ thm.selection.fg}}"
{% endif -%}

[colors.indexed]

[metadata]
name = "{{ thm.fullname }}"
origin_url = "{{ thm.url }}"
version = "{{ thm.version }}"
palette.name  = "{{ pal.name }}"
palette.desc  = "{{ pal.desc }}"
palette.mode  = "{{ pal.mode }}"
palette.version = "{{ pal.version }}"
